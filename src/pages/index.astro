---
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { withBase } from "astro-theme-university/url";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
import "../styles/site.css";

const progression = [
  { num: "01", step: "Notice" },
  { num: "02", step: "Break" },
  { num: "03", step: "Construct" },
  { num: "04", step: "Test" },
  { num: "05", step: "Integrate" },
];

const entries = [
  {
    title: sessionLabels.plural,
    href: "/sessions/",
    description: "The twelve-week schedule and what happens in each week.",
    accent: "red",
  },
  {
    title: "Lectures",
    href: "/lectures/",
    description: "What is covered, week by week, and which topics each lecture draws on.",
    accent: "blue",
  },
  {
    title: "Assessment",
    href: "/assessments/",
    description: "What is marked, what it is worth, and when it is due.",
    accent: "mustard",
  },
  {
    title: "Showcase",
    href: "/showcase/",
    description: "Where student work will appear once it has been produced.",
    accent: "red",
  },
];
---

<BaseLayout title={courseMeta.title} description="Breaking the Rules of Visual Storytelling" {...siteConfig}>
  <div class="home-hero">
    <div class="home-hero__intro">
      <p class="course-kicker">
        {courseMeta.code} · {courseMeta.session}, {courseMeta.year}
      </p>
      <h1>{courseMeta.title}</h1>
      <p class="lead">Breaking the Rules of Visual Storytelling</p>
      <p>{courseMeta.description}</p>
    </div>

    <div class="home-hero__question">
      <span class="home-hero__question-label">The Question</span>
      <p>What happens when a picture book refuses to behave like a normal book?</p>
    </div>
  </div>

  <ol class="progression">
    {
      progression.map((p) => (
        <li>
          <span class="progression__num">{p.num}</span>
          {p.step}
        </li>
      ))
    }
  </ol>
  <p>
    Every week takes one convention of picture books — a rule about pictures,
    words, sequence, page turns, or the physical page — and follows it
    through this fixed progression: notice the rule, break it on purpose,
    construct something from the break, test it on a reader, then decide
    whether to integrate it into your own work. A rule is never broken just
    for novelty — each break has to do something to the reader.
  </p>

  <h2>Where to go next</h2>
  <div class="home-entries">
    {
      entries.map((entry, index) => (
        <a class={`course-card course-card--${entry.accent}`} href={withBase(entry.href)}>
          <span class="course-card__num">{String(index + 1).padStart(2, "0")}</span>
          <span class="course-card__title">{entry.title}</span>
          <span class="course-card__desc">{entry.description}</span>
          <span class="course-card__arrow" aria-hidden="true">
            →
          </span>
        </a>
      ))
    }
  </div>
</BaseLayout>
