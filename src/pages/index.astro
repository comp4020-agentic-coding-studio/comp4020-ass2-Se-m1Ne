---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
import "../styles/site.css";

const progression = ["Notice", "Break", "Construct", "Test", "Integrate"];
---

<ContentLayout
  title={courseMeta.title}
  description="Breaking the Rules of Visual Storytelling"
  heroImage={heroImage}
  heroImageAlt="A lecture theatre reduced to flat gold and black shapes, rows of seats sweeping past the frame, in a two-ink risograph print"
  {...siteConfig}
>
  <div class="course-home">
    <ul class="course-tags" aria-label="Course tags">
      {courseMeta.tags.map((tag) => <li>{tag}</li>)}
    </ul>

    <p class="course-question">
      What happens when a picture book refuses to behave like a normal book?
    </p>

    <p>{courseMeta.description}</p>

    <h2>How the studio works</h2>
    <ol class="course-progression">
      {progression.map((step, i) => (
        <li>
          <span class="step-index">{String(i + 1).padStart(2, "0")}</span>
          {step}
        </li>
      ))}
    </ol>
    <p>
      Every week takes one convention of picture books — a rule about
      pictures, words, sequence, page turns, or the physical page — and
      follows it through this fixed progression: notice the rule, break it on
      purpose, construct something from the break, test it on a reader, then
      decide whether to integrate it into your own work. A rule is never
      broken just for novelty — each break has to do something to the reader.
    </p>

    <h2>Where to go next</h2>
    <div class="course-index-grid">
      <CardGrid columns={2}>
        <Card title={sessionLabels.plural} href="/sessions/">
          <p>The twelve-week schedule and what happens in each week.</p>
        </Card>
        <Card title="Lectures" href="/lectures/">
          <p>What is covered, week by week, and which topics each lecture draws on.</p>
        </Card>
        <Card title="Assessment" href="/assessments/">
          <p>What is marked, what it is worth, and when it is due.</p>
        </Card>
        <Card title="Showcase" href="/showcase/">
          <p>Where student work will appear once it has been produced.</p>
        </Card>
      </CardGrid>
    </div>
  </div>
</ContentLayout>
