---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import { withBase } from "astro-theme-university/url";
import ContentLayout from "../../layouts/ContentPageLayout.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import SequentialNavigation from "../../components/SequentialNavigation.astro";
import { graphCollections, siteConfig } from "../../site-config";
import "../../styles/site.css";

export async function getStaticPaths() {
  const sessions = await getPublishedCollection("sessions");
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session } }));
}

const { session } = Astro.props;
const { Content } = await render(session);

const orderedSessions = (await getPublishedCollection("sessions")).sort((a, b) => a.data.week - b.data.week);
const sessionIndex = orderedSessions.findIndex((s) => s.id === session.id);
const previousSession = sessionIndex > 0 ? orderedSessions[sessionIndex - 1] : undefined;
const nextSession = sessionIndex < orderedSessions.length - 1 ? orderedSessions[sessionIndex + 1] : undefined;
---

<ContentLayout
  title={`Week ${session.data.week}: ${session.data.title}`}
  description={session.data.description}
  {...siteConfig}
>
  <Content />
  <SpecList spec={session.data.spec}>
    What you bring to the session. Written so a reader can tell whether it has
    been met without asking you.
  </SpecList>
  <TeachingTeam teachers={session.data.teachers} />
  <RelatedContent entry={session} collections={graphCollections} />
  <SequentialNavigation
    previous={
      previousSession && {
        href: withBase(`/sessions/${previousSession.id}/`),
        label: `Week ${String(previousSession.data.week).padStart(2, "0")}: ${previousSession.data.title}`,
      }
    }
    next={
      nextSession && {
        href: withBase(`/sessions/${nextSession.id}/`),
        label: `Week ${String(nextSession.data.week).padStart(2, "0")}: ${nextSession.data.title}`,
      }
    }
    positionLabel={`WEEK ${String(session.data.week).padStart(2, "0")} / ${orderedSessions.length}`}
  />
</ContentLayout>
