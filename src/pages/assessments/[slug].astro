---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import Callout from "astro-theme-university/components/Callout.astro";
import { withBase } from "astro-theme-university/url";
import ContentLayout from "../../layouts/ContentPageLayout.astro";
import MarkingModel from "../../components/MarkingModel.astro";
import SequentialNavigation from "../../components/SequentialNavigation.astro";
import { dueLabel } from "../../lib/assessment-due";
import { graphCollections, siteConfig } from "../../site-config";
import "../../styles/site.css";

export async function getStaticPaths() {
  const assessments = await getPublishedCollection("assessments");
  return assessments.map((assessment) => ({
    params: { slug: assessment.id },
    props: { assessment },
  }));
}

const { assessment } = Astro.props;
const { Content } = await render(assessment);

const orderedAssessments = (await getPublishedCollection("assessments")).sort((a, b) => a.data.week - b.data.week);
const assessmentIndex = orderedAssessments.findIndex((a) => a.id === assessment.id);
const previousAssessment = assessmentIndex > 0 ? orderedAssessments[assessmentIndex - 1] : undefined;
const nextAssessment =
  assessmentIndex < orderedAssessments.length - 1 ? orderedAssessments[assessmentIndex + 1] : undefined;
---

<ContentLayout
  title={assessment.data.title}
  description={assessment.data.description}
  {...siteConfig}
>
  {
    assessment.data.draft && (
      <Callout type="warning">
        <p>
          <strong>Draft.</strong> This brief is still being finalised and may change.
        </p>
      </Callout>
    )
  }
  <p><strong>Due:</strong> {dueLabel(assessment.data)} · <strong>Weight:</strong> {assessment.data.weight}%</p>
  <Content />
  <SpecList spec={assessment.data.spec}>
    The brief poses the problem and leaves room for a response. The spec is the
    fixed part: what a marker checks. Some lines can be checked mechanically;
    the rest call for judgement.
  </SpecList>
  {assessment.data.marking && <MarkingModel marking={assessment.data.marking} />}
  <RelatedContent entry={assessment} collections={graphCollections} />
  <SequentialNavigation
    previous={
      previousAssessment && {
        href: withBase(`/assessments/${previousAssessment.id}/`),
        label: previousAssessment.data.title,
      }
    }
    next={
      nextAssessment && {
        href: withBase(`/assessments/${nextAssessment.id}/`),
        label: nextAssessment.data.title,
      }
    }
    positionLabel={`ASSESSMENT ${assessmentIndex + 1} / ${orderedAssessments.length}`}
  />
</ContentLayout>
