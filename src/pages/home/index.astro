---
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { withBase } from "astro-theme-university/url";
import SearchEnhance from "../../components/SearchEnhance.astro";
import { courseMeta } from "../../course-config";
import { learningOutcomes } from "../../lib/learning-outcomes";
import { sessionLabels, siteConfig } from "../../site-config";
import "../../styles/site.css";

const progression = [
  { num: "01", step: "Notice" },
  { num: "02", step: "Break" },
  { num: "03", step: "Construct" },
  { num: "04", step: "Test" },
  { num: "05", step: "Integrate" },
];

const audiences = [
  "illustration",
  "visual communication and design",
  "animation",
  "HCI",
  "creative writing",
  "media arts",
  "comics and sequential art",
  "storytelling",
  "education",
];

const entries = [
  {
    title: sessionLabels.plural,
    href: "/sessions/",
    description: "The twelve-week schedule and what happens in each week.",
  },
  {
    title: "Lectures",
    href: "/lectures/",
    description: "What is covered, week by week, and which topics each lecture draws on.",
  },
  {
    title: "Assessment",
    href: "/assessments/",
    description: "What is marked, what it is worth, and when it is due.",
  },
  {
    title: "Showcase",
    href: "/showcase/",
    description: "Where student work will appear once it has been produced.",
  },
];
---

<BaseLayout title={courseMeta.title} description="Breaking the Rules of Visual Storytelling" {...siteConfig}>
  <SearchEnhance slot="head" />
  <div class="home-hero">
    <div class="home-hero__intro">
      <p class="course-kicker">{courseMeta.code}</p>
      <h1>{courseMeta.title}</h1>
      <p class="lead">Breaking the Rules of Visual Storytelling</p>
      <p>{courseMeta.description}</p>
    </div>

    <div class="home-hero__question">
      <span class="home-hero__question-label">The Question</span>
      <p>What happens when a picture book refuses to behave like a normal book?</p>
    </div>
  </div>

  <h2>Who is this course for?</h2>
  <p>
    This course is for students interested in how stories work across
    words, images, pages and readers. It may be especially relevant to
    students in {audiences.slice(0, -1).join(", ")}, and {audiences.at(-1)}.
  </p>
  <p>
    No formal prerequisite is required, and you do not need polished
    drawing skills. Collage, photography, typography, digital shapes, found
    images, paper cut-outs and simple drawings are all valid ways of
    working.
  </p>

  <h2>How the course develops</h2>
  <ol class="progression">
    {
      progression.map((p) => (
        <li>
          <span class="progression__num">{p.num}</span>
          {p.step}
        </li>
      ))
    }
  </ol>
  <p>
    Each week takes one convention of picture books — a rule about pictures,
    words, sequence, page turns, or the physical page — and runs it through
    this progression: notice the rule that normally makes a picture book
    easy to read, break it on purpose, construct something from the break,
    test how readers respond, then decide whether that particular
    misbehaviour is worth keeping. A rule is never broken just for novelty —
    each break has to do something to the reader.
  </p>

  <h2>What will you learn?</h2>
  <div class="card-grid">
    {
      learningOutcomes.map((outcome) => (
        <a class="course-card course-card--teal" href={withBase(`/learning-outcomes/${outcome.slug}/`)}>
          <span class="course-card__num">{outcome.number}</span>
          <span class="course-card__title">{outcome.title}</span>
          <span class="course-card__desc">{outcome.description}</span>
          <span class="course-card__meta">{outcome.weekRangeLabel}</span>
          <span class="course-card__arrow" aria-hidden="true">
            →
          </span>
        </a>
      ))
    }
  </div>

  <h2>Where to go next</h2>
  <div class="home-entries">
    {
      entries.map((entry, index) => (
        <a class="course-card course-card--coral" href={withBase(entry.href)}>
          <span class="course-card__num">{String(index + 1).padStart(2, "0")}</span>
          <span class="course-card__title">{entry.title}</span>
          <span class="course-card__desc">{entry.description}</span>
          <span class="course-card__arrow" aria-hidden="true">
            →
          </span>
        </a>
      ))
    }
  </div>
</BaseLayout>
