---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

const sessions = await getPublishedCollection("sessions");
const visible = sessions.sort((a, b) => a.data.week - b.data.week);
---

<ol class="index-list">
  {
    visible.map((session) => (
      <li>
        <a href={withBase(`/sessions/${session.id}/`)}>
          <span class="index-list__num">{String(session.data.week).padStart(2, "0")}</span>
          <span class="index-list__body">
            <span class="index-list__title">{session.data.title}</span>
            {session.data.description && <span class="index-list__desc">{session.data.description}</span>}
          </span>
        </a>
      </li>
    ))
  }
</ol>
