---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

const sessions = await getPublishedCollection("sessions");
const visible = sessions.sort((a, b) => a.data.week - b.data.week);
---

<div class="card-grid">
  {
    visible.map((session) => (
      <a class="course-card course-card--coral" href={withBase(`/sessions/${session.id}/`)}>
        <span class="course-card__num">Week {String(session.data.week).padStart(2, "0")}</span>
        <span class="course-card__title">{session.data.title}</span>
        {session.data.description && <span class="course-card__desc">{session.data.description}</span>}
        <span class="course-card__arrow" aria-hidden="true">
          →
        </span>
      </a>
    ))
  }
</div>
