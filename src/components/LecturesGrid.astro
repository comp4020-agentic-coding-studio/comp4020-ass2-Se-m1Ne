---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

const lectures = await getPublishedCollection("lectures");
const visible = lectures.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<ol class="index-list">
  {
    visible.map((lecture) => (
      <li>
        <a href={withBase(`/lectures/${lecture.id}/`)}>
          <span class="index-list__num">{String(lecture.data.week).padStart(2, "0")}</span>
          <span class="index-list__body">
            <span class="index-list__title">{lecture.data.title}</span>
            {lecture.data.description && <span class="index-list__desc">{lecture.data.description}</span>}
          </span>
          {lecture.data.slides && <span class="index-list__meta">Slides</span>}
        </a>
      </li>
    ))
  }
</ol>
