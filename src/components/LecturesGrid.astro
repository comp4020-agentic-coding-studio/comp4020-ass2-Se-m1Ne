---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

const lectures = await getPublishedCollection("lectures");
const visible = lectures.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<div class="lecture-list">
  {
    visible.map((lecture) => (
      <a class="course-card course-card--row course-card--coral" href={withBase(`/lectures/${lecture.id}/`)}>
        <span class="course-card__num">Week {String(lecture.data.week).padStart(2, "0")}</span>
        <span class="course-card__body">
          <span class="course-card__title">{lecture.data.title}</span>
          {lecture.data.description && <span class="course-card__desc">{lecture.data.description}</span>}
        </span>
        {lecture.data.slides && <span class="course-card__meta">Slides</span>}
        <span class="course-card__arrow" aria-hidden="true">
          →
        </span>
      </a>
    ))
  }
</div>
