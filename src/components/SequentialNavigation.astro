---
// Previous/Next controls shared by Week, Lecture, and Assessment detail
// pages. Plain accessible anchor navigation — no client-side script.
interface NavTarget {
  href: string;
  label: string;
}

interface Props {
  previous?: NavTarget;
  next?: NavTarget;
  /** Restrained centre indicator, e.g. "WEEK 06 / 12" or "ASSESSMENT 2 / 4". */
  positionLabel: string;
}

const { previous, next, positionLabel } = Astro.props;
---

<nav class="sequential-nav" aria-label="Sequential navigation">
  <div class="sequential-nav__side sequential-nav__side--prev">
    {
      previous && (
        <a href={previous.href} rel="prev">
          <span class="sequential-nav__arrow" aria-hidden="true">
            ←
          </span>
          <span class="sequential-nav__copy">
            <span class="sequential-nav__hint">Previous</span>
            <span class="sequential-nav__label">{previous.label}</span>
          </span>
        </a>
      )
    }
  </div>
  <p class="sequential-nav__position">{positionLabel}</p>
  <div class="sequential-nav__side sequential-nav__side--next">
    {
      next && (
        <a href={next.href} rel="next">
          <span class="sequential-nav__copy">
            <span class="sequential-nav__hint">Next</span>
            <span class="sequential-nav__label">{next.label}</span>
          </span>
          <span class="sequential-nav__arrow" aria-hidden="true">
            →
          </span>
        </a>
      )
    }
  </div>
</nav>
