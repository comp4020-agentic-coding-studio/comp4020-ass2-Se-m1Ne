---
import { getPublishedCollection } from "astro-course-university/content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import { formatCourseDate } from "../lib/dates";

const assessments = await getPublishedCollection("assessments");
const visible = assessments.sort((a, b) => a.data.week - b.data.week);
---

<div class="assessment-grid">
  <CardGrid columns={2}>
    {
      visible.map((assessment) => (
        <Card headingLevel="h2" title={assessment.data.title} href={`/assessments/${assessment.id}/`}>
          {assessment.data.description && <p>{assessment.data.description}</p>}
          {assessment.data.weight != null && (
            <p class="assessment-meta">
              <small>
                Due {formatCourseDate(assessment.data.due)}
                {assessment.data.draft && " · Draft"}
              </small>
              <strong class="weight-badge">{assessment.data.weight}%</strong>
            </p>
          )}
        </Card>
      ))
    }
  </CardGrid>
</div>
